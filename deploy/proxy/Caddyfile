# Example Caddyfile for Solstice.
# Put this file in /etc/caddy/Caddyfile.
# Replace solstice.example.com before use.
# Caddy gets and renews the HTTPS certificate by itself and already sends
# X-Forwarded-Proto and X-Forwarded-For: set SOLSTICE_HTTP_TRUSTEDPROXIES=127.0.0.1
# on Solstice so it believes that header.
# Check it with caddy validate --config /etc/caddy/Caddyfile, then systemctl reload caddy.
solstice.example.com {
	header Strict-Transport-Security max-age=31536000

	# Live updates (/api/events) must reach the browser without delay.
	reverse_proxy 127.0.0.1:8080 {
		flush_interval -1
	}
}
