{
  "name": "solstice",
  "description": "Solstice issue tracker, web interface",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && touch ../backend/internal/web/dist/.gitkeep",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.23.0",
    "fast-check": "^4.4.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-devanagari": "5.3.0",
    "prosemirror-commands": "1.7.2",
    "prosemirror-dropcursor": "1.8.4",
    "prosemirror-gapcursor": "1.4.1",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.6.0",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-transform": "1.12.4",
    "prosemirror-view": "1.42.9"
  }
}
