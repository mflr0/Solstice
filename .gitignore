.DS_Store
/data

# Jira distribution used as a schema reference: never commit it
/atlassian-jira-software-*/

# Frontend
frontend/node_modules/
frontend/coverage/
*.local
.vite/

# Vite builds the UI here and the Go binary embeds it; only the placeholder is tracked.
/backend/internal/web/dist/*
!/backend/internal/web/dist/.gitkeep

# Real Jira database dumps: private data, never commit them
*.sql
*.sql.gz
*.dump
/jiradb-*
# …but Solstice's own schema migrations are source code (embedded by the binary).
!/backend/internal/db/migrations/*.sql

# Local configuration, written by hand or by the setup wizard
solstice.conf

# Go binaries built in place
/backend/solstice
/backend/jira-fixture

# Local build outputs and logs
/.cache/

# Docker install: generated database passwords
/deploy/docker/.env

# Release archives
/dist/
